# Base URL of the Spring Boot backend API.
#
# Local development: /api/v1 goes through the Vite dev proxy to
# http://localhost:8080 (vite.config.ts). Leave this value as-is.
#
# Production (Cloudflare Pages): set VITE_API_BASE_URL in the Pages project's
# Production environment variables (build-time). It must be the full API
# origin without a trailing slash, e.g. https://api.example.com. The app
# fails fast at startup if it is missing in a production build.
VITE_API_BASE_URL=/api/v1
